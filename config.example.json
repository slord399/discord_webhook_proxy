{
    "port": 8080,
    "trustProxy": false,    // Set to 1 than true if behind a single reverse proxy (like Nginx) so the app securely reads users' real IPs without allowing header spoofing.
    "autoBlock": false,   // Automatically blocks and crashes the app if a proxy is detected without 'trustProxy' enabled, preventing global rate-limit lockouts.
    "queue": {
        "enabled": false,
        "rabbitmq": "amqp://guest:guest@localhost",
        "queue": "webhook-proxy"
    },
    "redis": "redis://127.0.0.1/0",
    "abuseThreshold": 12
}
